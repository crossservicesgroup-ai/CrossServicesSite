# ==========================================================================
# Copy this file to `.env.local` for local development, and set the same
# two values in Vercel under Project → Settings → Environment Variables.
#
# Until both are set, the quote form and the contact form still validate and
# confirm to the visitor, but the submission is written to the server console
# instead of being emailed. Nothing is silently lost — but nothing arrives in
# the inbox either, so set these before launch.
# ==========================================================================

# API key from resend.com
RESEND_API_KEY=

# An address on a domain you have verified inside Resend.
# Format: "Display Name <address@yourdomain.com>"
QUOTE_FROM_EMAIL="Cross Services Group <quotes@crossservicesgroup.com>"
