# ==========================================================================
# Template only — never put real values in this file. It IS committed to git.
#
# Copy it to `.env.local` for local development, and set the same values in
# Vercel under Project → Settings → Environment Variables.
#
# If any of these are missing, the quote form tells the visitor the request
# did not go through and logs the lead to the server console. It never
# reports success for an email that was not sent.
# ==========================================================================

# API key from resend.com
RESEND_API_KEY=

# Sender address, on a domain you have verified inside Resend.
# Format: "Display Name <address@yourdomain.com>"
QUOTE_FROM_EMAIL=

# Inbox that receives new quote requests.
# One address, or several separated by commas.
QUOTE_TO_EMAIL=
